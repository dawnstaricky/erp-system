<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.erpsystem.mapper.ExpenseMapper">

    <resultMap id="FormResultMap" type="com.example.erpsystem.entity.ExpenseForm">
        <id column="id" property="id"/>
        <result column="form_no" property="formNo"/>
        <result column="applicant_id" property="applicantId"/>
        <result column="dept_id" property="deptId"/>
        <result column="apply_date" property="applyDate"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="reason" property="reason"/>
        <result column="current_approver_id" property="currentApproverId"/>
        <result column="status" property="status"/>
        <result column="payment_date" property="paymentDate"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <resultMap id="ItemResultMap" type="com.example.erpsystem.entity.ExpenseItem">
        <id column="id" property="id"/>
        <result column="form_id" property="formId"/>
        <result column="expense_type_id" property="expenseTypeId"/>
        <result column="expense_date" property="expenseDate"/>
        <result column="amount" property="amount"/>
        <result column="invoice_count" property="invoiceCount"/>
        <result column="invoice_image" property="invoiceImage"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <resultMap id="RecordResultMap" type="com.example.erpsystem.entity.ApprovalRecord">
        <id column="id" property="id"/>
        <result column="form_id" property="formId"/>
        <result column="form_type" property="formType"/>
        <result column="approver_id" property="approverId"/>
        <result column="approve_result" property="approveResult"/>
        <result column="approve_comment" property="approveComment"/>
        <result column="approve_time" property="approveTime"/>
        <result column="level" property="level"/>
    </resultMap>

    <insert id="insertForm" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO expense_form (form_no, applicant_id, dept_id, apply_date, total_amount, reason, current_approver_id, status, payment_date, remark)
        VALUES (#{formNo}, #{applicantId}, #{deptId}, #{applyDate}, #{totalAmount}, #{reason}, #{currentApproverId}, #{status}, #{paymentDate}, #{remark})
    </insert>

    <update id="updateForm">
        UPDATE expense_form
        <set>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="currentApproverId != null">current_approver_id = #{currentApproverId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="paymentDate != null">payment_date = #{paymentDate},</if>
            <if test="remark != null">remark = #{remark},</if>
            updated_at = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectFormById" resultMap="FormResultMap">
        SELECT * FROM expense_form WHERE id = #{id}
    </select>

    <select id="generateFormNo" resultType="String">
        SELECT CONCAT('EXP', DATE_FORMAT(NOW(), '%Y%m%d'), LPAD(COALESCE(MAX(CAST(SUBSTRING(form_no, 12) AS UNSIGNED)), 0) + 1, 4, '0'))
        FROM expense_form WHERE form_no LIKE CONCAT('EXP', DATE_FORMAT(NOW(), '%Y%m%d'), '%')
    </select>

    <select id="getMyForms" resultMap="FormResultMap">
        SELECT * FROM expense_form WHERE applicant_id = #{applicantId} ORDER BY created_at DESC
    </select>

    <select id="getPendingForms" resultMap="FormResultMap">
        SELECT * FROM expense_form WHERE current_approver_id = #{approverId} AND status = 1
    </select>

    <insert id="insertItems">
        INSERT INTO expense_item (form_id, expense_type_id, expense_date, amount, invoice_count, invoice_image, remark)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.formId}, #{item.expenseTypeId}, #{item.expenseDate}, #{item.amount}, #{item.invoiceCount}, #{item.invoiceImage}, #{item.remark})
        </foreach>
    </insert>

    <select id="selectItemsByFormId" resultMap="ItemResultMap">
        SELECT * FROM expense_item WHERE form_id = #{formId}
    </select>

    <delete id="deleteItemsByFormId">
        DELETE FROM expense_item WHERE form_id = #{formId}
    </delete>

    <insert id="insertApprovalRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO approval_record (form_id, form_type, approver_id, approve_result, approve_comment, approve_time, level)
        VALUES (#{formId}, #{formType}, #{approverId}, #{approveResult}, #{approveComment}, #{approveTime}, #{level})
    </insert>

    <select id="selectRecordsByFormId" resultMap="RecordResultMap">
        SELECT * FROM approval_record
        WHERE form_id = #{formId} AND form_type = #{formType}
        ORDER BY level ASC
    </select>

</mapper>