<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.erpsystem.mapper.RoleMapper">
    <resultMap id="BaseResultMap" type="com.example.erpsystem.entity.Role">
        <id column="id" property="id"/>
        <result column="role_name" property="roleName"/>
        <result column="role_code" property="roleCode"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <!-- created_at / updated_at 靠驼峰自动映射，不在这里写 -->
    </resultMap>

    <sql id="Base_Column_List">
        id, role_name, role_code, description, status
    </sql>

    <!-- 查询所有角色 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM sys_role WHERE status = 1
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM sys_role WHERE id = #{id}
    </select>

    <!-- 新增角色 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_role (role_name, role_code, description, status)
        VALUES (#{roleName}, #{roleCode}, #{description}, #{status})
    </insert>

    <!-- 更新角色 -->
    <update id="update">
        UPDATE sys_role
        <set>
            <if test="roleName != null">role_name = #{roleName},</if>
            <if test="roleCode != null">role_code = #{roleCode},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除角色 -->
    <delete id="deleteById">
        DELETE FROM sys_role WHERE id = #{id}
    </delete>

    <!--新增带搜索的查询，动态拼接条件，不影响你原有的查询 -->
    <select id="selectAllWithSearch" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM sys_role
        WHERE status = 1
        <if test="roleName != null and roleName != ''">
            AND role_name LIKE CONCAT('%', #{roleName}, '%')
        </if>
        <if test="roleCode != null and roleCode != ''">
            AND role_code LIKE CONCAT('%', #{roleCode}, '%')
        </if>
        ORDER BY created_at DESC
    </select>

    <select id="selectByRoleCode" resultType="com.example.erpsystem.entity.Role">
        SELECT * FROM sys_role WHERE role_code = #{roleCode}
    </select>

</mapper>